{
  "name": "sigap-mobile",
  "version": "1.0.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "start:dev-client": "expo start --dev-client",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "eas:init": "npx eas-cli init",
    "build:dev:android": "npx eas-cli build --platform android --profile development",
    "build:preview:android": "npx eas-cli build --platform android --profile preview",
    "build:production:android": "npx eas-cli build --platform android --profile production"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@supabase/supabase-js": "^2.57.0",
    "expo": "~58.0.22",
    "expo-auth-session": "~58.0.16",
    "expo-crypto": "~58.0.7",
    "expo-dev-client": "~58.0.18",
    "expo-linking": "~58.0.15",
    "expo-location": "~58.0.20",
    "expo-web-browser": "~58.0.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-maps": "1.29.11",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-web": "^0.21.4"
  }
}
