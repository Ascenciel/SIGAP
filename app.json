{
  "expo": {
    "name": "SIGAP",
    "owner": "sulthansyarif",
    "slug": "sigap-mobile",
    "scheme": "sigap",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Izinkan SIGAP memakai lokasi Anda untuk menampilkan posisi di peta."
        }
      ]
    ],
    "splash": {
      "backgroundColor": "#F4F7F6"
    },
    "ios": {
      "bundleIdentifier": "com.tripleT.sigap",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.tripleT.sigap",
      "adaptiveIcon": {
        "backgroundColor": "#F4F7F6"
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "extra": {
      "eas": {
        "projectId": "f4023bb9-46c4-4cca-8482-8d232da7c66e"
      }
    }
  }
}
