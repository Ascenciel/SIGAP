{
  "expo": {
    "name": "SIGAP",
    "owner": "sulthansyarif",
    "slug": "sigap-mobile",
    "scheme": "sigap",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/sigap-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#F4F7F6"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Izinkan SIGAP memakai lokasi untuk menandai posisi Anda dan mencari alamat lokasi laporan."
        }
      ],
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "Izinkan SIGAP memilih foto sebagai bukti pendukung laporan.",
          "cameraPermission": "Izinkan SIGAP mengambil foto untuk laporan.",
          "microphonePermission": false
        }
      ]
    ],
    "ios": {
      "bundleIdentifier": "com.tripleT.sigap",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.tripleT.sigap",
      "edgeToEdgeEnabled": true,
      "adaptiveIcon": {
        "backgroundColor": "#F4F7F6"
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA"
      ]
    },
    "extra": {
      "eas": {
        "projectId": "f4023bb9-46c4-4cca-8482-8d232da7c66e"
      }
    }
  }
}
